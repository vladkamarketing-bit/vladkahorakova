---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Kicker from '../components/Kicker.astro';
import Check from '../components/Check.astro';
import CourseCard from '../components/CourseCard.astro';
import ContactForm from '../components/ContactForm.astro';
import home from '../data/home.json';
import site from '../data/site.json';

const sluzby = (await getCollection('sluzby')).sort((a, b) => a.data.order - b.data.order);
const main = sluzby.find((s) => s.data.main) ?? sluzby[0];
const others = sluzby.filter((s) => s !== main);
const kurzy = (await getCollection('kurzy')).filter((k) => k.data.active).sort((a, b) => a.data.order - b.data.order);
const teaser = [
  ...kurzy.filter((k) => k.data.audience === 'firmy').slice(0, 2),
  ...kurzy.filter((k) => k.data.audience === 'jednotlivci').slice(0, 1),
];
const cardBg = ['bg-vh-bronze', 'bg-vh-sage/80', 'bg-vh-dark'];
---

<Layout>

  <!-- HERO -->
  <section id="uvod" class="relative min-h-screen flex items-center bg-vh-ivory overflow-hidden">
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-vh-muted opacity-[0.08] pointer-events-none translate-x-1/4"></div>
    <div class="absolute inset-0 flex items-center justify-end overflow-hidden pointer-events-none select-none" aria-hidden="true">
      <span class="font-serif font-light leading-none text-vh-dark opacity-[0.06]" style="font-size: 100vh;">V</span>
    </div>

    <div class="relative max-w-6xl mx-auto px-6 pt-32 pb-24 w-full">
      <div class="max-w-5xl">
        <Kicker text={home.heroKicker} />
        <h1 class="font-serif leading-[1.1] text-vh-dark mb-8" style="font-size: clamp(3rem, 7vw, 5rem); font-weight: 400;">
          {home.heroTitle}<br />
          <span style="font-style: italic; font-size: calc(1em - 4px);">{home.heroTitleLine2}</span>
        </h1>
        <p class="text-vh-muted text-lg leading-relaxed mb-10 max-w-xl">{home.heroSubtitle}</p>
        <div class="flex flex-wrap items-center gap-6">
          <a href="#kontakt" class="px-8 py-4 bg-vh-sage text-white rounded-full text-sm font-medium hover:bg-vh-sage/80 transition-colors">{home.heroButton}</a>
          <a href="/kurzy/" class="text-vh-dark text-sm font-medium hover:text-vh-sage transition-colors group flex items-center gap-1">
            {home.heroLink} <span class="inline-block group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <dl class="mt-20 flex flex-col sm:flex-row sm:flex-wrap gap-y-6 sm:gap-x-16 border-t border-vh-dark/10 pt-8">
        {home.heroStats.map((s) => (
          <div>
            <dt class="font-serif text-3xl text-vh-dark">{s.value}</dt>
            <dd class="text-vh-muted text-sm mt-1">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>


  <!-- KDY SE OZVAT -->
  <section class="bg-white/50 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <Kicker text={home.problemsKicker} center />
        <h2 class="font-serif font-light text-5xl text-vh-dark mb-5">{home.problemsTitle}</h2>
        <p class="text-vh-muted text-sm leading-relaxed max-w-lg mx-auto">{home.problemsText}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {home.problems.map((p, i) => (
          <div class="bg-white rounded-2xl p-7 flex flex-col gap-5 border border-vh-dark/5">
            <span class="font-serif italic text-4xl text-vh-bronze/70 leading-none">0{i + 1}</span>
            <div class="flex-1">
              <h3 class="font-serif text-xl text-vh-dark mb-2 leading-snug">{p.title}</h3>
              <p class="text-vh-muted text-sm leading-relaxed">{p.text}</p>
            </div>
            <div class="h-1.5 w-10 bg-vh-ivory rounded-full"></div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- SLUŽBY -->
  <section id="sluzby" class="bg-vh-ivory py-24 scroll-mt-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-14">
        <div>
          <Kicker text={home.servicesKicker} />
          <h2 class="font-serif font-light text-5xl text-vh-dark leading-tight">{home.servicesTitle}</h2>
        </div>
        <p class="text-vh-muted leading-relaxed max-w-sm text-sm md:text-right">{home.servicesText}</p>
      </div>

      <!-- Hlavní služba -->
      <div class="bg-vh-sage rounded-2xl p-8 md:p-12 mb-5 grid md:grid-cols-2 gap-10">
        <div class="flex flex-col justify-between">
          <div>
            <p class="text-vh-sage-light text-xs uppercase tracking-widest mb-4">— {main.data.kicker}</p>
            <h3 class="font-serif font-light text-4xl text-white leading-tight mb-4"><a href={`/sluzby/${main.id}/`} class="hover:text-vh-sage-light transition-colors">{main.data.title}</a></h3>
            <p class="text-white/70 text-sm leading-relaxed mb-8">{main.data.short}</p>
          </div>
          <div class="flex flex-wrap items-center gap-6">
            <a href={`/sluzby/${main.id}/`} class="inline-block px-7 py-3.5 bg-white text-vh-sage rounded-full text-sm font-medium hover:bg-vh-ivory transition-colors">Více o poradenství</a>
            <a href="#kontakt" class="text-white/80 hover:text-white text-sm border-b border-white/30 hover:border-white pb-0.5 transition-colors">Nezávazná konzultace</a>
          </div>
        </div>
        <ul class="space-y-3 self-center">
          {main.data.deliverables.map((item) => (
            <li class="flex items-start gap-3 text-white/85 text-sm"><Check light />{item}</li>
          ))}
        </ul>
      </div>

      <!-- Další strategie -->
      <div class="grid md:grid-cols-3 gap-5">
        {others.map((s, i) => (
          <a href={`/sluzby/${s.id}/`} class={`${cardBg[i % 3]} group rounded-2xl p-8 flex flex-col no-underline`}>
            <p class="text-white/60 text-xs uppercase tracking-widest mb-3">{s.data.kicker}</p>
            <h3 class="font-serif font-light text-3xl text-white leading-tight mb-4">{s.data.title}</h3>
            <p class="text-white/70 text-sm leading-relaxed mb-6">{s.data.short}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 text-white/85 group-hover:text-white text-sm border-b border-white/30 group-hover:border-white pb-0.5 self-start transition-colors">
              Více o službě <span class="inline-block group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- PROCES -->
  <section class="bg-white/50 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <Kicker text={home.processKicker} center />
        <h2 class="font-serif font-light text-5xl text-vh-dark">{home.processTitle}</h2>
      </div>
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {home.process.map((step, i) => (
          <li class="relative pt-8 border-t border-vh-dark/15">
            <span class="absolute -top-px left-0 w-12 h-px bg-vh-bronze"></span>
            <p class="font-serif italic text-vh-bronze text-lg mb-2">Krok {i + 1}</p>
            <h3 class="font-serif text-2xl text-vh-dark mb-3">{step.title}</h3>
            <p class="text-vh-muted text-sm leading-relaxed">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>


  <!-- O MNĚ -->
  <section id="o-mne" class="bg-vh-ivory py-24 scroll-mt-16">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-[0.8fr_1.2fr] gap-16 items-center">
      <div class="relative max-w-sm mx-auto w-full">
        <div class="absolute -inset-4 rounded-2xl border border-vh-bronze/30 translate-x-4 translate-y-4" aria-hidden="true"></div>
        <img src={home.aboutPhoto} alt={home.aboutName} class="relative w-full aspect-[4/5] object-cover rounded-2xl" />
      </div>
      <div>
        <Kicker text={home.aboutKicker} />
        <h2 class="font-serif font-light text-5xl text-vh-dark leading-tight mb-3">{home.aboutName}</h2>
        <p class="font-serif italic text-vh-muted text-xl mb-8">{home.aboutSubtitle}</p>
        <div class="space-y-4 text-vh-muted text-sm leading-relaxed">
          {home.aboutParagraphs.map((p) => <p>{p}</p>)}
        </div>
        <ul class="grid sm:grid-cols-2 gap-3 mt-8">
          {home.aboutHighlights.map((h) => <li class="flex items-start gap-3 text-sm text-vh-dark"><Check />{h}</li>)}
        </ul>
      </div>
    </div>
  </section>


  <!-- KURZY -->
  <section class="bg-white/50 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-14">
        <div>
          <Kicker text={home.coursesKicker} />
          <h2 class="font-serif font-light text-5xl text-vh-dark leading-tight">{home.coursesTitle}</h2>
        </div>
        <p class="text-vh-muted leading-relaxed max-w-sm text-sm md:text-right">{home.coursesText}</p>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {teaser.map((k) => <CourseCard course={k} />)}
      </div>
      <p class="text-center mt-10">
        <a href="/kurzy/" class="inline-block px-8 py-4 border border-vh-dark text-vh-dark rounded-full text-sm font-medium hover:bg-vh-dark hover:text-white transition-colors">Všechny kurzy a školení</a>
      </p>
    </div>
  </section>


  <!-- REFERENCE (zobrazí se, až budou v administraci) -->
  {home.testimonials.length > 0 && (
    <section class="bg-vh-sage py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-14">
          <Kicker text={home.testimonialsKicker} center light />
          <h2 class="font-serif font-light text-5xl text-white">{home.testimonialsTitle}</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {home.testimonials.map((t: { quote: string; name: string; role: string }) => (
            <figure class="bg-vh-dark/20 rounded-2xl p-8">
              <p class="font-serif text-3xl text-white/30 leading-none mb-4">"</p>
              <blockquote class="text-white/80 text-sm leading-relaxed mb-8">{t.quote}</blockquote>
              <figcaption class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-full bg-vh-sage-light/30 flex items-center justify-center font-serif text-white">{t.name.trim().charAt(0)}</span>
                <span><span class="block text-white text-sm font-medium">{t.name}</span><span class="block text-white/50 text-xs">{t.role}</span></span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- CTA -->
  <section class="bg-vh-ivory pt-24 pb-12">
    <div class="max-w-xl mx-auto px-6 text-center flex flex-col items-center gap-6">
      <h2 class="font-serif font-light text-4xl text-vh-dark">{home.ctaTitle}</h2>
      <p class="text-vh-muted text-base leading-relaxed">{home.ctaText}</p>
      <a href="#kontakt" class="w-full px-10 py-5 bg-vh-sage text-white text-base font-medium rounded-lg hover:bg-vh-sage/85 transition-colors">{home.ctaButton}</a>
    </div>
  </section>


  <!-- FAQ -->
  <section class="bg-vh-ivory pt-12 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-12">
        <Kicker text={home.faqKicker} center />
        <h2 class="font-serif font-light text-5xl text-vh-dark">{home.faqTitle}</h2>
      </div>
      <div class="divide-y divide-vh-dark/10 border-y border-vh-dark/10">
        {home.faq.map((f) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-6 cursor-pointer list-none">
              <span class="font-serif text-xl text-vh-dark">{f.q}</span>
              <span class="w-8 h-8 shrink-0 rounded-full border border-vh-dark/15 flex items-center justify-center text-vh-muted group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="text-vh-muted text-sm leading-relaxed mt-3 pr-12">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- KONTAKT -->
  <section id="kontakt" class="bg-white/50 py-24 scroll-mt-16">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-start">
      <div>
        <Kicker text={home.contactKicker} />
        <h2 class="font-serif font-light text-5xl text-vh-dark leading-tight mb-6">{home.contactTitle}</h2>
        <p class="text-vh-muted text-sm leading-relaxed mb-10">{home.contactText}</p>
        <div class="space-y-4 text-sm">
          <p class="flex items-center gap-3 text-vh-dark">
            <svg class="w-5 h-5 text-vh-sage flex-shrink-0" viewBox="0 0 20 20" fill="none"><path d="M2 6l8 5 8-5M2 6v10a1 1 0 001 1h14a1 1 0 001-1V6a1 1 0 00-1-1H3a1 1 0 00-1 1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
            <a href={`mailto:${site.email}`} class="hover:text-vh-sage transition-colors">{site.email}</a>
          </p>
          {site.phone && (
            <p class="flex items-center gap-3 text-vh-dark">
              <svg class="w-5 h-5 text-vh-sage flex-shrink-0" viewBox="0 0 20 20" fill="none"><path d="M4 2h3l2 5-2 1a11 11 0 005 5l1-2 5 2v3a2 2 0 01-2 2A16 16 0 012 4a2 2 0 012-2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
              <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-vh-sage transition-colors">{site.phone}</a>
            </p>
          )}
        </div>
      </div>
      <ContactForm />
    </div>
  </section>

</Layout>
