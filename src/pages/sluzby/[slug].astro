---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Kicker from '../../components/Kicker.astro';
import Check from '../../components/Check.astro';
import ContactForm from '../../components/ContactForm.astro';

export async function getStaticPaths() {
  const sluzby = await getCollection('sluzby');
  return sluzby.map((s) => ({ params: { slug: s.id }, props: { sluzba: s } }));
}

const { sluzba } = Astro.props as { sluzba: CollectionEntry<'sluzby'> };
const s = sluzba.data;
const { Content } = await render(sluzba);
const others = (await getCollection('sluzby')).filter((x) => x.id !== sluzba.id).sort((a, b) => a.data.order - b.data.order);
---
<Layout title={s.seoTitle ?? `${s.title} — Vladka Horáková`} description={s.seoDescription ?? s.short}>
  <PageHead title={s.title} kicker={s.kicker} lead={s.lead} crumbs={[{ href: '/', label: 'Úvod' }, { href: '/#sluzby', label: 'Služby' }]}>
    <div class="flex flex-wrap items-center gap-6 mt-10">
      <a href="#poptavka" class="px-8 py-4 bg-vh-sage text-white rounded-full text-sm font-medium hover:bg-vh-sage/80 transition-colors">Nezávazná konzultace</a>
      {s.price && <p class="font-serif italic text-vh-bronze text-xl">{s.price}</p>}
    </div>
  </PageHead>

  <section class="bg-white/50 py-20">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-5">
      <div class="bg-white rounded-2xl p-8 md:p-10 border border-vh-dark/5">
        <p class="text-xs uppercase tracking-widest text-vh-bronze mb-4">Pro koho</p>
        <ul class="space-y-3">{s.forWho.map((x) => <li class="flex items-start gap-3 text-sm text-vh-dark"><Check />{x}</li>)}</ul>
      </div>
      <div class="bg-vh-sage rounded-2xl p-8 md:p-10">
        <p class="text-xs uppercase tracking-widest text-vh-sage-light mb-4">Co dostanete</p>
        <ul class="space-y-3">{s.deliverables.map((x) => <li class="flex items-start gap-3 text-sm text-white/85"><Check light />{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="bg-vh-ivory py-20">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-[1.3fr_1fr] gap-16">
      <div class="prose-vh text-vh-muted text-[15px] leading-relaxed"><Content /></div>
      {s.steps.length > 0 && (
        <aside>
          <Kicker text="Postup" />
          <ol class="space-y-6">
            {s.steps.map((st, i) => (
              <li class="flex gap-5">
                <span class="font-serif italic text-3xl text-vh-bronze/70 leading-none w-8 shrink-0">{i + 1}</span>
                <span><span class="block font-serif text-xl text-vh-dark">{st.title}</span><span class="block text-sm text-vh-muted leading-relaxed mt-1">{st.text}</span></span>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </section>

  <section id="poptavka" class="bg-white/50 py-24 scroll-mt-16">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-start">
      <div>
        <Kicker text="Poptávka" />
        <h2 class="font-serif font-light text-5xl text-vh-dark leading-tight mb-6">Pojďme se podívat na váš marketing</h2>
        <p class="text-vh-muted text-sm leading-relaxed">Popište mi stručně vaši situaci a cíle. Ozvu se do 24 hodin v pracovní dny a domluvíme si nezávaznou úvodní konzultaci.</p>
        <div class="mt-12">
          <p class="text-xs uppercase tracking-widest text-vh-muted mb-4">Další služby</p>
          <ul class="space-y-2">
            {others.map((o) => <li><a href={`/sluzby/${o.id}/`} class="font-serif text-xl text-vh-dark hover:text-vh-sage transition-colors">{o.data.title} →</a></li>)}
            <li><a href="/kurzy/" class="font-serif text-xl text-vh-dark hover:text-vh-sage transition-colors">Kurzy a školení →</a></li>
          </ul>
        </div>
      </div>
      <ContactForm subject={`Poptávka: ${s.title}`} topic={s.title} />
    </div>
  </section>
</Layout>
