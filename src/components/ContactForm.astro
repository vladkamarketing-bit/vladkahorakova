---
import site from '../data/site.json';
interface Props { subject?: string; topic?: string; }
const { subject = 'Nová zpráva z webu vladkahorakova.cz', topic } = Astro.props;
---
<form action={`https://formsubmit.co/${site.email}`} method="POST" class="space-y-5" data-ajax data-success="Děkuji, zpráva byla odeslána. Ozvu se vám do 24 hodin v pracovní dny.">
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  {topic && <input type="hidden" name="Téma" value={topic} />}
  <div class="grid sm:grid-cols-2 gap-4">
    <div><label class="field-label" for="cf-name">Jméno</label><input id="cf-name" name="Jméno" required autocomplete="name" placeholder="Vaše jméno" class="field" /></div>
    <div><label class="field-label" for="cf-company">Firma</label><input id="cf-company" name="Firma" autocomplete="organization" placeholder="Název firmy" class="field" /></div>
  </div>
  <div class="grid sm:grid-cols-2 gap-4">
    <div><label class="field-label" for="cf-email">E-mail</label><input id="cf-email" name="email" type="email" required autocomplete="email" placeholder="vas@email.cz" class="field" /></div>
    <div><label class="field-label" for="cf-phone">Telefon</label><input id="cf-phone" name="Telefon" type="tel" autocomplete="tel" placeholder="nepovinné" class="field" /></div>
  </div>
  <div><label class="field-label" for="cf-msg">S čím potřebujete pomoci</label><textarea id="cf-msg" name="Zpráva" rows="5" required placeholder="Popište stručně vaši situaci a cíle…" class="field resize-none"></textarea></div>
  <button type="submit" class="w-full py-4 bg-vh-sage text-white rounded-full text-sm font-medium hover:bg-vh-sage/80 transition-colors disabled:opacity-60 disabled:cursor-wait">Odeslat zprávu</button>
  <p class="text-xs text-vh-muted text-center leading-relaxed">Odesláním formuláře berete na vědomí, že vaše údaje zpracuji za účelem odpovědi na dotaz. Více v <a href="/ochrana-osobnich-udaju/" class="underline hover:text-vh-sage">zásadách ochrany osobních údajů</a>.</p>
  <p data-status class="hidden" role="status"></p>
</form>
