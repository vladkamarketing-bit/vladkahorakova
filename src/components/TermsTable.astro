---
import { upcoming, termDate, weekday, statusLabel, type Term } from '../lib/terms';
interface Props { courseId: string; terms: Term[]; firmy?: boolean; }
const { courseId, terms, firmy = false } = Astro.props;
const list = upcoming(terms);
const orderUrl = (i?: number) => `/kurzy/${courseId}/${i === undefined ? '' : `?termin=${i}`}#objednavka`;
const pill = { volno: 'bg-vh-sage-light/50 text-vh-sage', posledni: 'bg-vh-bronze/15 text-vh-bronze', obsazeno: 'bg-vh-dark/5 text-vh-muted' };
---
{list.length > 0 ? (
  <div class="bg-white rounded-2xl border border-vh-dark/5 overflow-hidden">
    <div class="hidden sm:grid grid-cols-[1.3fr_1fr_1.3fr_1fr_auto] gap-4 px-6 py-3 text-xs uppercase tracking-wider text-vh-muted border-b border-vh-dark/8">
      <span>Datum</span><span>Čas</span><span>Místo</span><span>Obsazenost</span><span class="w-28"></span>
    </div>
    <ul class="divide-y divide-vh-dark/8">
      {list.map((t, i) => (
        <li data-until={(t.end ?? t.date).toISOString().slice(0, 10)} class="grid grid-cols-2 sm:grid-cols-[1.3fr_1fr_1.3fr_1fr_auto] gap-x-4 gap-y-2 items-center px-6 py-4 text-sm">
          <span class="col-span-2 sm:col-span-1"><span class="font-serif text-xl text-vh-dark">{termDate(t)}</span><span class="block text-xs text-vh-muted">{weekday(t)}</span></span>
          <span class="text-vh-dark">{t.time ?? '—'}</span>
          <span class="text-vh-dark">{t.city}{t.venue && <span class="block text-xs text-vh-muted">{t.venue}</span>}</span>
          <span><span class={`inline-block px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap ${pill[t.status]}`}>{statusLabel[t.status]}</span></span>
          <span class="justify-self-end sm:w-28 sm:text-right">
            {t.status === 'obsazeno'
              ? <span class="text-xs text-vh-muted">Kapacita naplněna</span>
              : <a href={orderUrl(i)} class="inline-block px-5 py-2.5 bg-vh-sage text-white rounded-full text-sm font-medium hover:bg-vh-sage/80 transition-colors">Objednat</a>}
          </span>
        </li>
      ))}
    </ul>
  </div>
) : (
  <div class="bg-white rounded-2xl border border-vh-dark/5 px-6 py-5 flex flex-wrap items-center justify-between gap-4">
    <span class="text-sm"><span class="font-serif text-xl text-vh-dark">Termín dle dohody</span><span class="block text-xs text-vh-muted">{firmy ? 'Školení připravím na míru a termín domluvíme společně.' : 'Nové termíny připravuji – objednejte se a dám vám vědět jako první.'}</span></span>
    <a href={orderUrl()} class="inline-block px-5 py-2.5 bg-vh-sage text-white rounded-full text-sm font-medium hover:bg-vh-sage/80 transition-colors">{firmy ? 'Poptat školení' : 'Objednat'}</a>
  </div>
)}
